---
// Navegação principal: a marca e as duas ações (Baixar mapa, Usar mapa). Fundo opaco na cor da página, sem linha.
// Duas camadas iguais: a normal e, por cima, a invertida (claro sobre carmim). A invertida é recortada com clip-path
// para aparecer só na faixa da barra que já está sobre o rodapé, então a troca de cor acompanha a borda do rodapé
// (public/scripts/navegacao.js). A camada invertida fica fora do teclado e do leitor de tela.
// variante: "lockup" (nome sempre à vista, a escolhida) ou "olho" (ícone que vira olho e só então mostra o nome). Ver /dev/barra.
// Altura h-20 (80 px): a marca e os botões respiram longe do topo da janela.
import MarcaNav from "./MarcaNav.astro";
interface Props { variante?: "olho" | "lockup"; fixa?: boolean }
const { variante = "lockup", fixa = true } = Astro.props;
const atual = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const camadas = [
  { invertida: false, fundo: "bg-neutro-50" },
  { invertida: true, fundo: "bg-carmim-800" } // cores dos botões invertidos: .nav-invertida .botao em estilo.css
];
---
<header class:list={["nav z-10 bg-neutro-50", fixa ? "sticky top-0" : "relative"]}>
  {camadas.map((c) => (
    <div
      class:list={["nav-dentro mx-auto flex items-center h-20 max-w-none px-6 gap-6", c.fundo, { "nav-invertida absolute inset-x-0 top-0": c.invertida }]}
      style={c.invertida ? "clip-path: inset(100% 0 0 0); display: none" : undefined}
      aria-hidden={c.invertida ? "true" : undefined}
    >
      <MarcaNav invertida={c.invertida} sempreNome={variante === "lockup"} />
      <nav class="nav-links ml-auto flex items-center gap-2" aria-label={c.invertida ? undefined : "Principal"}>
        <a class="botao secundario botao-pequeno" href="/baixar" tabindex={c.invertida ? -1 : undefined}
          aria-current={!c.invertida && atual === "/baixar" ? "page" : undefined}>Baixar mapa</a>
        <a class="botao botao-pequeno" href="/mapa" tabindex={c.invertida ? -1 : undefined}>Usar mapa</a>
      </nav>
    </div>
  ))}
</header>
