  .b-texto p { margin: 0; text-wrap: pretty; }
  .b-link { display: inline-block; margin-top: 12px; font: 600 var(--tamanho-sm)/1 var(--fonte-inter); color: var(--carmim-800); text-decoration: none; }
  .b-link span { display: inline-block; transition: transform 200ms var(--ease-out); }
  .b-link:hover span, .b-imprimir:hover .b-link span { transform: translateX(3px); }

  /* Sistema de todos os blocos (decidido no primeiro bloco, em /dev/bento-mapa e /dev/bento-estados, 18/11/2026):
     cantos de 0.375rem, borda em degradê de cima para baixo, e as cores do bloco ativo e do inativo
     (o regente troca uma pela outra; entre os estados só mudam as cores). */
  .bloco-b { border-radius: 0.375rem;
    --ativo-borda-topo: var(--coral-200); --ativo-borda-pe: var(--neutro-50); --ativo-titulo: var(--texto-900); --ativo-descricao: var(--texto-700); --ativo-lista: var(--texto-700); --ativo-pontos: var(--coral-600); --ativo-fundo: var(--coral-100);
    --inativo-borda-topo: var(--neutro-200); --inativo-borda-pe: var(--neutro-50); --inativo-titulo: var(--texto-600); --inativo-descricao: var(--texto-600); --inativo-lista: var(--texto-700); --inativo-pontos: var(--neutro-400); --inativo-fundo: var(--neutro-100);
    --cor-borda-topo: var(--ativo-borda-topo); --cor-borda-pe: var(--ativo-borda-pe); --cor-titulo: var(--ativo-titulo); --cor-descricao: var(--ativo-descricao); --cor-lista: var(--ativo-lista); --cor-pontos: var(--ativo-pontos); --cor-fundo: var(--ativo-fundo);
    /* borda em degradê (fundo no padding-box, degradê no border-box) */
    border-color: transparent;
    background: linear-gradient(var(--cor-fundo), var(--cor-fundo)) padding-box, linear-gradient(to bottom, var(--cor-borda-topo), var(--cor-borda-pe)) border-box;
    color: var(--cor-lista);
    transition: --cor-borda-topo var(--estado-ms) ease, --cor-borda-pe var(--estado-ms) ease, --cor-titulo var(--estado-ms) ease, --cor-descricao var(--estado-ms) ease, --cor-lista var(--estado-ms) ease, --cor-pontos var(--estado-ms) ease, --cor-fundo var(--estado-ms) ease; }
  .bento[data-regendo]:not([data-unico]) > .bloco-b:not([data-ativo]), .bloco-b[data-estado="inativo"] {
    --cor-borda-topo: var(--inativo-borda-topo); --cor-borda-pe: var(--inativo-borda-pe); --cor-titulo: var(--inativo-titulo); --cor-descricao: var(--inativo-descricao); --cor-lista: var(--inativo-lista); --cor-pontos: var(--inativo-pontos); --cor-fundo: var(--inativo-fundo); }
  .b-texto h3 { font-family: var(--fonte-dm-sans); font-size: var(--tamanho-xl); font-weight: 700; color: var(--cor-titulo); }
  .b-texto p { font-size: var(--tamanho-md); font-weight: 400; color: var(--cor-descricao); max-width: 20rem; }

  /* 1. O mapa (valores de /dev/bento-mapa, 18/11/2026) */
  .b-visoes { grid-column: span 4; grid-row: span 2; padding: 28px 0 0 28px; min-height: 360px; }
  .b-visoes .b-texto { padding-right: 28px; }
  /* texto ao lado do mapa: o quadro encosta em cima, na direita e embaixo */
  .b-visoes[data-disposicao="lado"] { flex-direction: row; gap: 28px; padding: 0 0 0 28px; }
  .b-visoes[data-disposicao="lado"] .b-texto { flex: 1 1 0; min-width: 0; padding: 28px 0; display: flex; flex-direction: column; }
  /* lista de filtros: no pé da coluna de texto, embaixo à esquerda */
  .b-filtros { list-style: none; margin: auto 0 0; padding: 20px 0 0; display: flex; flex-direction: column; gap: 8px; font: 400 var(--tamanho-sm)/1.3 var(--fonte-inter); color: var(--cor-lista); }
  /* ponto em em: acompanha o tamanho do texto e fica no meio da primeira linha (line-height 1.3 → meio em 0.65em) */
  .b-filtros li { position: relative; padding-left: 0.9em; }
  .b-filtros li::before { content: ""; position: absolute; left: 0; top: calc(0.65em - 0.15em); width: 0.3em; height: 0.3em; border-radius: 50%; background: var(--cor-pontos); }
  .b-visoes[data-disposicao="lado"] .quadro { margin-top: var(--quadro-espaco); flex: 0 0 54%; height: 280px; min-height: 0; align-self: flex-end; }
  /* valores do quadro escolhidos em /dev/bento-mapa (18/11/2026) */
  .b-visoes .quadro { --quadro-fade-x: 64%; --quadro-fade-y: 48%; --quadro-raio: 4px; --quadro-espaco: 26px; --quadro-min: 460px; --quadro-borda: var(--neutro-50); }
  .b-desafio { grid-column: span 2; grid-row: span 2; }
  .b-funcoes { grid-column: span 2; }
  .b-praticas { grid-column: span 2; }
  .b-contato { grid-column: span 2; }
  .b-imprimir { grid-column: span 3; }
  .b-origem { grid-column: span 3; }

  /* Estados do regente: um bloco ativo, os outros quietos (só com a sequência rodando; ajustáveis em /dev/bento-sequencia) */
  /* entre ativo e inativo só mudam as cores (18/11/2026): opacidade, saturação, escala e sombra ficam neutras */
  .bento { --inativo-opacidade: 1; --inativo-saturacao: 1; --inativo-escala: 1; --inativo-desfoque: 0px;
    --ativo-escala: 1; --ativo-sombra: none; --estado-ms: 500ms;
    --progresso-cor: var(--coral-500); --progresso-altura: 3px; }
  .bento[data-regendo]:not([data-unico]) > .bloco-b[data-visivel] {
    transition: opacity var(--estado-ms) ease, filter var(--estado-ms) ease, scale var(--estado-ms) var(--ease-out), box-shadow var(--estado-ms) ease, border-color var(--estado-ms) ease, transform 600ms var(--ease-out),
      --cor-borda-topo var(--estado-ms) ease, --cor-borda-pe var(--estado-ms) ease, --cor-titulo var(--estado-ms) ease, --cor-descricao var(--estado-ms) ease, --cor-lista var(--estado-ms) ease, --cor-pontos var(--estado-ms) ease, --cor-fundo var(--estado-ms) ease; }
  .bento[data-regendo]:not([data-unico]) > .bloco-b[data-visivel]:not([data-ativo]) {
    opacity: var(--inativo-opacidade); filter: saturate(var(--inativo-saturacao)) blur(var(--inativo-desfoque)); scale: var(--inativo-escala); }
  .bento[data-regendo]:not([data-unico]) > .bloco-b[data-ativo] { scale: var(--ativo-escala); box-shadow: var(--ativo-sombra); }
  /* barra que mostra quanto falta para o próximo bloco */
  .bloco-b::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: var(--progresso-altura); background: var(--progresso-cor);
    transform-origin: left; transform: scaleX(0); opacity: 0; pointer-events: none; z-index: 3; }
  .bento[data-regendo][data-progresso="sim"]:not([data-unico]) > .bloco-b[data-ativo]::after { opacity: 1; animation: progresso var(--tempo, 4000ms) linear forwards; }
  .bento[data-segurando] > .bloco-b[data-ativo]::after { opacity: 0 !important; animation: none !important; }
  @keyframes progresso { to { transform: scaleX(1); } }
  /* blocos sem laço próprio: as folhas só flutuam e as barras de origem crescem de novo quando o bloco é o ativo */
  .bento[data-regendo]:not([data-unico]) .b-imprimir:not([data-ativo]) .folha { animation-play-state: paused; }
  .bento[data-regendo]:not([data-unico]) .b-origem[data-ativo] .origem-barra::after { animation: crescer 900ms var(--ease-out) both; animation-delay: calc(var(--i) * 120ms); }
  @keyframes crescer { from { transform: scaleX(0); } to { transform: scaleX(var(--p)); } }

  /* entrada em cascata, uma vez */
  [data-revelar] { opacity: 0; transform: translateY(16px); transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out); transition-delay: calc(var(--ordem, 0) * 80ms); }
  [data-revelar][data-visivel] { opacity: 1; transform: none; }

  /* 1. O mapa num quadro: encostado na direita e embaixo do bloco, sumindo num degradê */
  /* ajustáveis no playground /dev/bento-mapa */
  .quadro { --quadro-fade-x: 74%; --quadro-fade-y: 70%; --quadro-raio: 12px; --quadro-espaco: 8px; --quadro-min: 420px; --quadro-borda: var(--neutro-300); }
  .quadro { position: relative; flex: 1; min-height: var(--quadro-min); margin-top: var(--quadro-espaco); border-top-left-radius: var(--quadro-raio); overflow: hidden;
    border: 1px solid var(--quadro-borda); border-right: 0; border-bottom: 0; background: var(--neutro-50);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 16px 40px -16px rgb(0 0 0 / 0.16);
    /* degradê para a direita (menos na barra do topo, para os botões ficarem à vista) e para baixo */
    --topo: 31px;
    mask-image: linear-gradient(to bottom, #000 var(--quadro-fade-y), transparent), linear-gradient(#000, #000), linear-gradient(to right, #000 var(--quadro-fade-x), transparent);
    mask-size: 100% 100%, 100% var(--topo), 100% 100%; mask-repeat: no-repeat; mask-composite: intersect, add;
    -webkit-mask-image: linear-gradient(to bottom, #000 var(--quadro-fade-y), transparent), linear-gradient(#000, #000), linear-gradient(to right, #000 var(--quadro-fade-x), transparent);
    -webkit-mask-size: 100% 100%, 100% var(--topo), 100% 100%; -webkit-mask-repeat: no-repeat; -webkit-mask-composite: source-in, source-over; }
  .quadro-palco { position: absolute; left: 0; top: 0; transform-origin: 0 0; transform: scale(var(--escala, 0.7)); }
  .quadro-palco iframe { display: block; border: 0; background: var(--neutro-50); }
  .cursor { position: absolute; left: 0; top: 0; width: 22px; height: 22px; margin: -3px 0 0 -5px; pointer-events: none; z-index: 2; opacity: 0; transition: opacity 250ms ease;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.25)); }
  .cursor path { fill: var(--texto-950); stroke: var(--neutro-50); stroke-width: 1.5; stroke-linejoin: round; }
  .cursor[data-visivel] { opacity: 1; }

  /* 2. Nível de desafio */
  .desafio-grafico { position: relative; margin: auto 0 0; }
  .desafio-grafico svg { display: block; width: 100%; height: auto; overflow: visible; }
  .trilha line { stroke: var(--neutro-300); stroke-width: 1; stroke-dasharray: 2 3; }
  .trilha text { font: 500 9px var(--fonte-inter); fill: var(--texto-600); }
  .trecho { fill: none; stroke: var(--carmim-800); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .ponto { transform-box: fill-box; transform-origin: center; }
  .desafio-grafico[data-vazio] .trecho { stroke-dashoffset: 1; }
