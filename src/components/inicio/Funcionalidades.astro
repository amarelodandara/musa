  .ponto image { transform-box: fill-box; transform-origin: center; transition: transform 200ms var(--ease-out); }
  .ponto[data-ativo] image { transform: scale(1.25); }
  .ponto-n { font: 600 8px var(--fonte-inter); fill: var(--texto-400); transition: fill 150ms ease; }
  .ponto[data-ativo] .ponto-n { fill: var(--carmim-800); }
  .ponto-alvo { position: absolute; width: 36px; height: 36px; translate: -50% -50%; border: 0; border-radius: 50%; background: transparent; cursor: pointer; padding: 0; }
  .fala { margin: 0; padding: 16px; border-radius: 0.375rem; background: var(--neutro-100); border: 1px solid var(--neutro-200); min-height: 96px; transition: opacity 120ms ease, filter 120ms ease, transform 120ms ease; }
  .fala[data-trocando] { opacity: 0; filter: blur(3px); transform: translateY(3px); }
  .fala blockquote { margin: 0 0 6px; font: 500 var(--tamanho-md)/1.35 var(--fonte-dm-sans); color: var(--texto-950); text-wrap: balance; hyphens: manual; }
  .fala figcaption { font-size: var(--tamanho-xs); color: var(--texto-600); }

  /* 3. Funções */
  .contador { margin: auto 0 0; display: flex; align-items: baseline; gap: 8px; }
  .contador-n { font: 700 var(--tamanho-5xl)/1 var(--fonte-dm-sans); letter-spacing: -0.03em; color: var(--carmim-900); font-variant-numeric: tabular-nums; display: inline-block; }
  .contador-r { font-size: var(--tamanho-sm); color: var(--texto-700); }
  .fichas { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .fichas button { font: 500 var(--tamanho-xs)/1 var(--fonte-inter); padding: 7px 10px; border-radius: 999px; border: 1px solid var(--coral-300); background: transparent; color: var(--texto-700); cursor: pointer; transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease, transform 160ms var(--ease-out); }
  .fichas button[aria-pressed="true"] { background: var(--coral-500); border-color: var(--coral-500); color: var(--texto-950); }
  .fichas button:active { transform: scale(0.96); }

  /* 4. Práticas */
  .placar { display: flex; gap: 24px; margin-top: auto; }
  .placar p { margin: 0; font-size: var(--tamanho-xs); color: var(--cor-descricao); }
  .placar strong { display: block; font: 700 var(--tamanho-4xl)/1 var(--fonte-dm-sans); letter-spacing: -0.03em; color: var(--cor-titulo); }
  .barra-dupla { display: flex; gap: 3px; height: 8px; }
  .barra-dupla span { border-radius: 4px; background: var(--coral-400); transform-origin: left; transform: scaleX(0); transition: transform 900ms var(--ease-out) 200ms; }
  .barra-dupla span + span { background: var(--carmim-500); transform-origin: right; }
  .b-praticas[data-visivel] .barra-dupla span { transform: none; }
  .exemplos { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; min-height: 4.4lh; align-content: start; font-size: var(--tamanho-xs); line-height: 1.4; color: var(--cor-lista); }
  .exemplos li { display: grid; grid-template-columns: 14px 1fr; }
  .exemplos em { font-style: normal; display: block; }
  .exemplos span { font-weight: 700; color: var(--coral-400); }
  .exemplos .evitar span { color: var(--carmim-400); }

  /* 5. Pontos de contato */
  .canais { display: flex; flex-wrap: wrap; gap: 6px; margin: auto 0 0; padding: 0; list-style: none; }
  .canais li { padding: 4px 10px; border-radius: 999px; background: var(--neutro-50); border: 1px solid var(--neutro-300); font-size: var(--tamanho-xs);
    opacity: 0; transform: translateY(6px) scale(0.96);
    transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out), background-color 500ms ease, border-color 500ms ease, color 500ms ease;
    transition-delay: calc(200ms + var(--i) * 40ms), calc(200ms + var(--i) * 40ms), 0ms, 0ms, 0ms; }
  .b-contato[data-visivel] .canais li { opacity: 1; transform: none; }
  .canais li[data-aceso] { background: var(--coral-200); border-color: var(--coral-400); color: var(--texto-950); transition-duration: 300ms, 300ms, 120ms, 120ms, 120ms; }

  /* 6. Imprimir */
  .folhas { display: flex; align-items: flex-end; justify-content: flex-end; gap: 14px; margin-top: auto; padding: 8px 4px 0; }
  .folha { position: relative; flex: none; width: var(--l); height: var(--a); padding: 4px; border-radius: 2px; background: var(--neutro-50); border: 1px solid var(--neutro-300); box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.2);
    rotate: calc((var(--i) - 1) * -2deg); animation: flutuar 5s ease-in-out infinite; animation-delay: calc(var(--i) * -1.6s); transition: rotate 300ms var(--ease-out); }
  .b-imprimir:hover .folha { rotate: calc((var(--i) - 1) * -5deg); }
  @keyframes flutuar { 0%, 100% { translate: 0 0; } 50% { translate: 0 -4px; } }
  .folha-grade { display: flex; gap: 2px; height: 100%; }
  .folha-grade i { flex: 1; border-top: 2px solid var(--carmim-800); background: repeating-linear-gradient(to bottom, var(--neutro-200) 0 2px, transparent 2px 6px); }
  .folha-rotulo { position: absolute; left: 6px; bottom: 6px; padding: 1px 4px; border-radius: 3px; background: var(--neutro-50); font: 700 var(--tamanho-2xs)/1.2 var(--fonte-inter); color: var(--carmim-800); }

  /* 7. Origem */
  .origens-func { display: grid; gap: 10px; margin: auto 0 0; }
