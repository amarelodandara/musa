---
// Folhas do Mapa da Visita para os PDFs (ADR 0004). Página interna: scripts/pdfs.mjs abre cada formato num navegador
// automatizado e salva o PDF em public/arquivos/.
// O conteúdo de cada folha é o próprio mapa no modo de impressão (/mapa?impressao=…, ver mapa.astro e src/scripts/mapa.ts):
// linhas de Etapa, Ações do professor e Nível de desafio iguais às da tela e, abaixo, uma linha pautada até o fim da
// folha para a equipe escrever. Aqui só se monta a folha: o mapa entra num quadro do tamanho do papel dividido pela
// escala e é ampliado de volta (assim o texto fica do tamanho certo para cada papel).
//   a1 → uma folha A1 paisagem, a jornada inteira
//   a2 → uma folha A2 paisagem, a jornada inteira
//   a4 → três páginas A4 paisagem, uma por Fase
export function getStaticPaths() {
  return ["a1", "a2", "a4"].map((formato) => ({ params: { formato } }));
}
const { formato } = Astro.params as { formato: "a1" | "a2" | "a4" };
// papel em mm; escala = quanto o mapa é ampliado no papel (maior = letra maior, menos espaço)
const PAPEL = { a1: { w: 841, h: 594, escala: 1.5 }, a2: { w: 594, h: 420, escala: 1.1 }, a4: { w: 297, h: 210, escala: 0.8 } }[formato];
const PX = 96 / 25.4;
const larg = (PAPEL.w * PX) / PAPEL.escala, alt = (PAPEL.h * PX) / PAPEL.escala;
const folhas = formato === "a4" ? [1, 2, 3].map((f) => `/mapa?impressao=a4&fase=${f}`) : [`/mapa?impressao=${formato}`];
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<title>Mapa da Visita · impressão {formato.toUpperCase()} · musá</title>
<style is:inline set:html={`@page { size: ${PAPEL.w}mm ${PAPEL.h}mm; margin: 0; }
  :root { --w: ${PAPEL.w}mm; --h: ${PAPEL.h}mm; --larg: ${larg}px; --alt: ${alt}px; --escala: ${PAPEL.escala}; }`}></style>
<style is:inline>
  html, body { margin: 0; background: #fdf9f9; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  .folha { position: relative; width: var(--w); height: var(--h); overflow: hidden; break-after: page; }
  .folha:last-child { break-after: auto; }
  .folha iframe { position: absolute; left: 0; top: 0; width: var(--larg); height: var(--alt); border: 0; transform: scale(var(--escala)); transform-origin: 0 0; }
</style>
</head>
<body class={`formato-${formato}`}>
  {folhas.map((src) => <section class="folha"><iframe src={src} title="Mapa da Visita"></iframe></section>)}
</body>
</html>
