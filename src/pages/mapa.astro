  .det-bloco h3 { margin: 0 0 8px; font-size: var(--tamanho-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--texto-600); }
  .det-bloco p { margin: 4px 0 0; }
  .det-sentimento { display: flex; gap: 8px; align-items: center; }
  .det-sentimento img { opacity: 0.8; }
  .det-bloco blockquote { margin: 8px 0 0; padding-left: 12px; border-left: 2px solid var(--neutro-400); font-style: italic; color: var(--texto-700); }
  .det-lista { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
  .det-lista .pratica { display: block; }
