  /* rodapé: crédito à esquerda, links à direita; quebra em duas linhas quando falta espaço */
  .mapa-rodape { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding: 16px;
    border-top: var(--linha); background: var(--neutro-50); font-size: var(--tamanho-xs); line-height: 1.5; color: var(--texto-600); }
