  /* Impressão (?impressao=a1|a2|a4; scripts/pdfs.mjs abre assim e salva o PDF): o próprio mapa na visão geral, com as
     linhas de Etapa, Ações do professor e Nível de desafio iguais às da tela; abaixo delas, uma linha pautada até o fim
     da folha para a equipe escrever. A folha tem o tamanho da janela (o script acerta a janela ao papel). */
  .impressao-topo, .rotulo-notas, .camada-notas { display: none; }
  :root[data-impressao], :root[data-impressao] body { overflow: hidden; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  :root[data-impressao] .mapa { height: 100vh; min-height: 0; }
