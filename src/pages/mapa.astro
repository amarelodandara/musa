  .mapa-rodape a { color: var(--texto-900); text-decoration: none; border-radius: 2px; }
  .mapa-rodape-credito a { color: inherit; text-decoration: underline; text-decoration-color: var(--neutro-400); text-underline-offset: 3px; }
  .mapa-rodape a:hover { color: var(--carmim-800); text-decoration: underline; text-decoration-color: currentColor; text-underline-offset: 3px; }
  .mapa-rodape a:focus-visible { outline: 2px solid var(--texto-950); outline-offset: 2px; }
  :root[data-vitrine] .mapa-rodape { display: none; }

  /* celular: só o modo etapa, uma coluna na tela */
  @media (max-width: 760px) {
