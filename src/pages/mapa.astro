  :root[data-impressao] .impressao-topo img { height: 40px; }
  .impressao-titulo { margin: 0; font-family: var(--fonte-inter); font-size: var(--tamanho-xl); font-weight: 600; color: var(--carmim-800); }
  .impressao-sub { margin: 2px 0 0; font-size: var(--tamanho-sm); color: var(--texto-700); }
  :root[data-impressao] .mapa-rolagem { overflow: visible; display: flex; flex-direction: column; }
  :root[data-impressao] .mapa-grade { flex: 1; --colunas: repeat(var(--n), minmax(0, 1fr)); grid-template-rows: auto auto auto auto 0 0 1fr; }
  :root[data-impressao] .rotulos .rotulo-pontos, :root[data-impressao] .rotulos .rotulo-praticas,
  :root[data-impressao] .camada-pontos, :root[data-impressao] .camada-praticas { display: none; }
  /* as linhas escondidas saem da grade (display: none não ocupa faixa): a pauta vai para a última faixa, a de 1fr */
  :root[data-impressao] .rotulo-notas, :root[data-impressao] .camada-notas { display: block; grid-row: -2 / -1; }
  /* pauta clara: uma linha a cada 28px, começando depois do respiro da célula */
  .camada-notas { --pauta: 28px; background: repeating-linear-gradient(to bottom, transparent 0 calc(var(--pauta) - 1px), var(--neutro-200) calc(var(--pauta) - 1px) var(--pauta))
