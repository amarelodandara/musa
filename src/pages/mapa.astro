    letter-spacing: 0.025em; color: var(--coral-500); }
  /* nomes das Etapas fechadas (e de todas na visão geral): menores e sem peso, para a aberta se destacar */
  .mapa[data-modo="inteiro"] .etapa-nome,
  .mapa[data-modo="etapa"] .etapa:not([data-aberta]) .etapa-nome { font-size: var(--tamanho-sm); font-weight: 400; color: var(--texto-950); }

  /* modo mapa inteiro */
  /* --colunas vai na grade, onde --n existe (no .mapa ela ficaria inválida e as colunas cairiam no tamanho compacto) */
  .mapa[data-modo="inteiro"] .mapa-grade { --colunas: repeat(var(--n), var(--col-inteira)); }

  /* conteúdo do painel de detalhe (copiado dos <template> pelo ControlesMapa) */
  .detalhe-corpo { padding: 16px 24px 48px; font-size: var(--tamanho-sm); line-height: 1.5; }
  .det-fase { margin: 0; font-size: var(--tamanho-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--texto-600); }
  .det-descricao { color: var(--texto-700); }
