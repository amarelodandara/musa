---
// Guia: entrada. Título, os dois pontos de partida (começar e imprimir), os grupos do glossário e, no fim, o "Leia mais"
// (fontes de fora em duas colunas, dados em src/lib/leia-mais.ts; ajustável em /dev/guia-leia-mais-grade). Ícones do Iconoir, sem repetir os das pills de pontos de contato.
import Guia from "../../layouts/Guia.astro";
import TracoGiz from "../../components/TracoGiz.astro";
import { fontes, TIPOS } from "../../lib/leia-mais";
import { icone } from "../../lib/pontos-contato";
import { gruposGlossario } from "../../lib/glossario";
import { paginasGuia } from "../../lib/guia";

// os dois pontos de partida: título, texto e ícone vêm dos próprios guias (os mesmos do menu lateral)
const PARTIDAS = ["como-comecar", "como-imprimir"].map((slug) => paginasGuia.find((p) => p.slug === slug)!)
  .map((p) => ({ titulo: p.titulo, texto: p.resumo, href: `/guia/${p.slug}`, Icone: icone(p.icone) }));
// Leia mais: o domínio do link, para mostrar no cartão (sem o www.)
const dominio = (href: string) => { try { return new URL(href).hostname.replace(/^www\./, ""); } catch { return ""; } };
const iconeProps = { width: "1.5em", height: "1.5em", strokeWidth: 1.6, "aria-hidden": "true" };
---
<Guia titulo="Guia">
<div class="guia-entrada" data-termos="lista" data-leia-link="seta" data-leia-layout="lista" data-lista-autoria="linha" data-lista-tipo="nome">
  <h1>Como musá?</h1>
  <p class="lead">Entenda como usar essa ferramenta.</p>

  <ul class="cartoes cartoes-partida">
    {PARTIDAS.map(({ titulo, texto, href, Icone }) => (
      <li><a class="cartao" href={href}>
        <Icone {...iconeProps} />
        <strong>{titulo}</strong>
        <span>{texto}</span>
      </a></li>
    ))}
  </ul>

  <TracoGiz class="divisor" />
  <section class="secao" aria-labelledby="glossario-titulo">
    <h2 id="glossario-titulo"><a href="/guia/glossario">Glossário</a></h2>
    {/* o mergulho nos conceitos (antes no lead do topo) fica com o glossário, que é onde eles estão */}
    <p class="secao-descricao">Mergulhe nos conceitos que a equipe pesquisou para montar o mapa.</p>
    <ul class="cartoes">
      {gruposGlossario.map((g) => { const Icone = icone(g.icone); return (
        <li class="cartao grupo">
          <Icone {...iconeProps} />
          <a class="grupo-titulo" href={`/guia/glossario#${g.id}`}><strong>{g.titulo}</strong></a>
          <ul class="grupo-termos">
            {g.termos.map((t) => <li><a href={`/guia/glossario#${t.id}`}>{t.nome}</a></li>)}
          </ul>
        </li>
      ); })}
    </ul>
  </section>

  <TracoGiz class="divisor" />
  {/* Leia mais: fontes de fora para aprofundar os assuntos do site (dados de exemplo em src/lib/leia-mais.ts), em lista
      (data-leia-layout="lista" no .guia-entrada): título e autoria à esquerda, tipo e seta à direita; com link, a linha
      inteira leva à fonte, em outra aba. A versão em cartões continua no CSS, em teste em /dev/guia-leia-mais-cartao */}
  <section class="secao" aria-labelledby="leia-mais">
    {/* scroll-margin: ao chegar pelo menu lateral (/guia#leia-mais), o título não fica colado no topo */}
    <h2 id="leia-mais" class="secao-ancora">Leia mais</h2>
    <p class="secao-descricao">Aprofunde os assuntos do mapa com livros, artigos e documentos sobre educação em museus, públicos escolares e design de serviços.</p>
    <ul class="cartoes cartoes-leia">
      {/* partes que só aparecem conforme os ajustes (em teste em /dev/guia-leia-mais-cartao): o nome do tipo (leia-tipo),
          o ano (leia-ano) e três jeitos de mostrar o link (o domínio, "Acesse" ou só a seta, no canto) */}
      {fontes.map((f) => { const Icone = icone(TIPOS[f.tipo].icone); const conteudo = (<>
        <Icone {...iconeProps} aria-label={TIPOS[f.tipo].rotulo} aria-hidden={undefined} role="img" />
        <span class="leia-tipo" aria-hidden="true">{TIPOS[f.tipo].rotulo}</span>
        <strong class="leia-titulo">{f.titulo}</strong>
        <span class="leia-autoria">{f.autoria}<span class="leia-ano"> · {f.ano}</span></span>
        {f.href && <span class="leia-link"><span class="leia-link-dominio">{dominio(f.href)}</span><span class="leia-link-texto">Acesse</span> <span class="leia-seta" aria-hidden="true">↗</span><span class="visualmente-escondido"> (abre em outra aba)</span></span>}
      </>); return (
        <li>{f.href
          ? <a class="cartao leia" data-tipo={f.tipo} href={f.href} target="_blank" rel="noopener noreferrer">{conteudo}</a>
          : <div class="cartao leia" data-tipo={f.tipo}>{conteudo}</div>}</li>
      ); })}
    </ul>
  </section>
</div>
</Guia>

<style>
  h1 { margin: 0 0 12px; font-size: var(--tamanho-3xl); text-wrap: balance; }
  .lead { max-width: 36rem; text-wrap: pretty; }
  /* Cartões das grades (ajustáveis em /dev/guia-cartoes pelas variáveis --cartao-*): quase quadrados, de largura fixa;
     a grade não precisa ocupar a largura toda. Sistema do bento: cantos de 0.375rem, fundo claro, ícone coral. */
  /* valores de /dev/guia-cartoes (19/11/2026) */
  .guia-entrada { --cartao-largura: 300px; --cartao-gap: 24px; --cartao-proporcao: 1; --cartao-respiro: 20px; --cartao-raio: 4px;
    /* fundo e borda em degradê de cima para baixo, como os blocos do bento (parado e com o mouse em cima) */
    --cartao-fundo-topo: var(--neutro-100); --cartao-fundo-pe: var(--neutro-100); --cartao-borda-topo: var(--coral-100); --cartao-borda-pe: var(--neutro-50);
    --cartao-hover-fundo-topo: var(--coral-100); --cartao-hover-fundo-pe: var(--coral-100); --cartao-hover-borda-topo: var(--coral-200); --cartao-hover-borda-pe: var(--neutro-50);
    --cartao-icone: 2.5em; --cartao-icone-cor: var(--carmim-700); --cartao-titulo: var(--tamanho-lg); --cartao-titulo-peso: 600; --cartao-titulo-cor: var(--texto-900);
    --cartao-texto: var(--tamanho-md); --cartao-texto-cor: var(--texto-700); --cartao-espaco: 6px; --cartao-termos: var(--tamanho-sm); --cartao-termos-cor: var(--texto-700);
    /* a lista de termos nos cartões do glossário (ajustável em /dev/guia-glossario-lista): linha corrida, lista ou chips;
       hoje em lista (data-termos="lista" no .guia-entrada). Valores de /dev/guia-glossario-lista (19/11/2026) */
    /* o título dos cartões do glossário, à parte do dos cartões de partida (parte dos mesmos valores) */
    --grupo-titulo: var(--tamanho-md); --grupo-titulo-peso: 500; --grupo-titulo-cor: var(--cartao-titulo-cor); --grupo-titulo-hover-cor: var(--cartao-titulo-cor);
    --termos-peso: 400;
    /* o ícone dos cartões do glossário puxado para a esquerda: o Iconoir deixa uma folga em volta do desenho, então o traço
       começava depois da linha do texto */
    --grupo-icone-recuo: -4px; --termos-hover-cor: var(--carmim-700); --termos-gap-x: 12px; --termos-gap-y: 4px; --termos-acima: 0px; --termos-separador: none;
    --termos-chip-fundo: var(--neutro-50); --termos-chip-hover-fundo: var(--coral-100); --termos-chip-raio: 999px; --termos-chip-px: 8px; --termos-chip-py: 2px; }
  .cartoes { display: grid; grid-template-columns: repeat(auto-fill, var(--cartao-largura)); gap: var(--cartao-gap); margin: 24px 0 0; padding: 0; list-style: none; }
  .cartoes > li { margin: 0; }
  /* quadrado (cresce se o texto não couber); ícone em cima, texto embaixo */
  /* as quatro cores registradas como <color> para o degradê transicionar no hover */
  @property --c-fundo-topo { syntax: "<color>"; inherits: false; initial-value: transparent; }
  @property --c-fundo-pe { syntax: "<color>"; inherits: false; initial-value: transparent; }
  @property --c-borda-topo { syntax: "<color>"; inherits: false; initial-value: transparent; }
  @property --c-borda-pe { syntax: "<color>"; inherits: false; initial-value: transparent; }
  .cartao { display: flex; flex-direction: column; align-items: flex-start; gap: var(--cartao-espaco); aspect-ratio: var(--cartao-proporcao); box-sizing: border-box; padding: var(--cartao-respiro);
    --c-fundo-topo: var(--cartao-fundo-topo); --c-fundo-pe: var(--cartao-fundo-pe); --c-borda-topo: var(--cartao-borda-topo); --c-borda-pe: var(--cartao-borda-pe);
    /* borda em degradê: fundo no padding-box, degradê da borda no border-box */
    border: 1px solid transparent; border-radius: var(--cartao-raio); color: inherit; text-decoration: none;
    background: linear-gradient(var(--c-fundo-topo), var(--c-fundo-pe)) padding-box, linear-gradient(var(--c-borda-topo), var(--c-borda-pe)) border-box;
    transition: --c-fundo-topo 200ms ease, --c-fundo-pe 200ms ease, --c-borda-topo 200ms ease, --c-borda-pe 200ms ease; }
  .cartao :global(svg) { flex: none; width: var(--cartao-icone); height: var(--cartao-icone); margin-bottom: auto; padding-bottom: 12px; color: var(--cartao-icone-cor); }
  .cartao strong { font: var(--cartao-titulo-peso) var(--cartao-titulo)/1.25 var(--fonte-dm-sans); color: var(--cartao-titulo-cor); text-wrap: balance; }
  .cartao span { font-size: var(--cartao-texto); color: var(--cartao-texto-cor); text-wrap: pretty; }
  /* os cartões do glossário não são um link só (título e termos), mas mudam de cor do mesmo jeito: com o mouse ou o foco dentro */
  a.cartao:hover, .guia-entrada[data-hover] a.cartao, .cartao.grupo:hover, .cartao.grupo:focus-within, .guia-entrada[data-hover] .cartao.grupo, .cartao.grupo[data-forcar-hover], a.cartao[data-forcar-hover] {
    --c-fundo-topo: var(--cartao-hover-fundo-topo); --c-fundo-pe: var(--cartao-hover-fundo-pe); --c-borda-topo: var(--cartao-hover-borda-topo); --c-borda-pe: var(--cartao-hover-borda-pe); }
  /* entre as seções, o traço de giz (TracoGiz) no lugar da linha */
  :global(.traco-giz.divisor) { margin: 72px 0 40px; }
  .secao h2 { margin: 0 0 8px; font-size: var(--tamanho-2xl); }
  .secao-ancora { scroll-margin-top: 104px; }
  .secao-descricao { max-width: 36rem; margin: 0; color: var(--texto-700); text-wrap: pretty; }
  .secao h2 a { color: inherit; text-decoration: none; }
  .secao h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cartao.grupo > :global(svg) { margin-left: var(--grupo-icone-recuo); }
  .grupo-titulo { color: inherit; text-decoration: none; }
  .grupo .grupo-titulo strong { font: var(--grupo-titulo-peso) var(--grupo-titulo)/1.25 var(--fonte-dm-sans); color: var(--grupo-titulo-cor); transition: color 150ms ease; }
  .grupo-titulo:hover strong, .grupo-titulo[data-forcar-hover] strong { color: var(--grupo-titulo-hover-cor); text-decoration: underline; text-underline-offset: 3px; }
  .grupo-termos { display: flex; flex-wrap: wrap; gap: var(--termos-gap-y) var(--termos-gap-x); margin: var(--termos-acima) 0 0; padding: 0; list-style: none; }
  .grupo-termos li { margin: 0; font-size: var(--cartao-termos); color: var(--cartao-termos-cor); }
  /* separador entre os termos (na linha corrida), metade do espaço de cada lado */
  .grupo-termos li + li::before { content: var(--termos-separador); margin-right: var(--termos-gap-x); }
  .grupo-termos a { font-size: var(--cartao-termos); font-weight: var(--termos-peso); color: var(--cartao-termos-cor); text-decoration: none; transition: color 150ms ease, background-color 150ms ease; }
  .grupo-termos a:hover, .grupo-termos a[data-forcar-hover] { color: var(--termos-hover-cor); text-decoration: underline; text-underline-offset: 3px; }
  .guia-entrada[data-termos="lista"] .grupo-termos { flex-direction: column; }
  .guia-entrada[data-termos="lista"] .grupo-termos li + li::before, .guia-entrada[data-termos="chips"] .grupo-termos li + li::before { content: none; }
  .guia-entrada[data-termos="chips"] .grupo-termos a { display: inline-block; padding: var(--termos-chip-py) var(--termos-chip-px); border-radius: var(--termos-chip-raio); background: var(--termos-chip-fundo); }
  .guia-entrada[data-termos="chips"] .grupo-termos a:hover, .guia-entrada[data-termos="chips"] .grupo-termos a[data-forcar-hover] { background: var(--termos-chip-hover-fundo); text-decoration: none; }
  /* Leia mais (ajustável em /dev/guia-leia-mais-cartao, variáveis --leia-* e data-leia-* no .guia-entrada): duas colunas,
     cartões na altura do conteúdo; o ícone grande, de traço fino, na coluna da esquerda, colado no topo */
  /* valores de /dev/guia-leia-mais-cartao (19/11/2026); o link é só a seta, no canto (data-leia-link="seta" no .guia-entrada) */
  .guia-entrada { --leia-gap: 16px; --leia-respiro: 24px; --leia-icone: 2.6em; --leia-icone-gap: 11px; --leia-icone-cor: var(--neutro-600);
    --leia-icone-traco: 0.5; --leia-icone-recuo: -6px;
    /* até onde a borda fica na cor de cima antes de desbotar para a de baixo: os cartões do Leia mais são baixos, e o degradê
       meio a meio dos outros cartões deixava a cor só num canto; aqui ela vai até 75% e desbota no último quarto */
    --leia-borda-ate: 75%;
    --leia-titulo: var(--tamanho-md); --leia-titulo-peso: 500; --leia-titulo-cor: var(--texto-900); --leia-autoria: var(--tamanho-sm); --leia-autoria-cor: var(--texto-600);
    --leia-link: var(--tamanho-sm); --leia-link-cor: var(--neutro-800); }
  .cartoes.cartoes-leia { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--leia-gap); }
  .cartao.leia { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--leia-icone-gap); row-gap: 2px;
    align-content: start; height: 100%; aspect-ratio: auto; padding: var(--leia-respiro); }
  /* o texto na segunda coluna. ":not(svg)": o Astro põe o atributo de escopo também no svg do ícone, e um "> *" (que vira
     "> [data-astro-cid-…]") ganhava da regra do ícone e o jogava em cima do título */
  .cartao.leia > :not(svg) { grid-column: 2; }
  .cartao.leia { background: linear-gradient(var(--c-fundo-topo), var(--c-fundo-pe)) padding-box,
    linear-gradient(var(--c-borda-topo) var(--leia-borda-ate), var(--c-borda-pe)) border-box; }
  /* o ícone na primeira coluna, colado no topo; o traço afinado compensa o tamanho (escala de 24 do Iconoir) */
  .cartao.leia > :global(svg) { grid-column: 1; grid-row: 1 / span 5; align-self: start; width: var(--leia-icone); height: var(--leia-icone); stroke-width: var(--leia-icone-traco);
    margin: 0 0 0 var(--leia-icone-recuo); padding: 0; color: var(--leia-icone-cor); }
  a.cartao.leia:focus-visible, a.cartao.leia[data-forcar-foco] { outline: 2px solid var(--carmim-700); outline-offset: 2px; }
  /* tudo prefixado com .cartao.leia: as regras gerais ".cartao strong" e ".cartao span" (dos cartões de partida) pesam mais
     que uma classe sozinha e prendiam o título e a autoria nos tamanhos e cores delas */
  .cartao.leia span { font-size: inherit; color: inherit; }
  .cartao.leia .leia-titulo { font: var(--leia-titulo-peso) var(--leia-titulo)/1.3 var(--fonte-dm-sans); color: var(--leia-titulo-cor); text-wrap: pretty; }
  .cartao.leia .leia-autoria { font-size: var(--leia-autoria); line-height: 1.4; color: var(--leia-autoria-cor); text-wrap: pretty; }
  .cartao.leia .leia-tipo { font: 600 var(--tamanho-xs)/1.3 var(--fonte-inter); color: var(--leia-icone-cor); }
  .cartao.leia .leia-tipo, .cartao.leia .leia-ano, .cartao.leia .leia-link-texto { display: none; }
  .cartao.leia .leia-link { margin-top: 6px; font-size: var(--leia-link); font-weight: 500; color: var(--leia-link-cor); }
  .cartao.leia .leia-seta { display: inline-block; transition: translate 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  a.cartao.leia:hover .leia-seta, a.cartao.leia[data-forcar-hover] .leia-seta { translate: 2px -2px; }
  /* variações (data-* no .guia-entrada, em teste em /dev/guia-leia-mais-cartao) */
  .guia-entrada[data-leia-icone="cima"] .cartao.leia { grid-template-columns: minmax(0, 1fr); }
  .guia-entrada[data-leia-icone="cima"] .cartao.leia > :not(svg) { grid-column: 1; }
  .guia-entrada[data-leia-icone="cima"] .cartao.leia > :global(svg) { grid-row: auto; margin-bottom: 10px; }
  .guia-entrada[data-leia-tipo] .cartao.leia .leia-tipo { display: block; }
  .guia-entrada[data-leia-ano] .cartao.leia .leia-ano { display: inline; }
  .guia-entrada[data-leia-link="texto"] .cartao.leia .leia-link-dominio { display: none; }
  .guia-entrada[data-leia-link="texto"] .cartao.leia .leia-link-texto { display: inline; }
  .guia-entrada[data-leia-link="seta"] .cartao.leia .leia-link { position: absolute; top: var(--leia-respiro); right: var(--leia-respiro); margin: 0; }
  .guia-entrada[data-leia-link="seta"] .cartao.leia .leia-link-dominio { display: none; }
  .guia-entrada[data-leia-link="seta"] .cartao.leia { padding-right: calc(var(--leia-respiro) + 1.25em); }
  /* ---------- Leia mais em lista (data-leia-layout="lista" no .guia-entrada, em teste em /dev/guia-leia-mais-lista) ----------
     cada fonte numa linha da largura toda: título e autoria à esquerda; à direita o tipo (ícone e nome) e a seta do link.
     A coluna da seta tem largura fixa, então o tipo alinha também nas linhas sem link. */
  /* valores de /dev/guia-leia-mais-lista (19/11/2026); a arrumação escolhida lá é autoria na mesma linha e o tipo só com o
     nome (data-lista-autoria="linha" e data-lista-tipo="nome", junto com data-leia-layout="lista") */
  .guia-entrada { --lista-py: 12px; --lista-gap: 8px; --lista-divisor: var(--coral-100); --lista-divisor-espessura: 1px;
    --lista-titulo: var(--tamanho-md); --lista-titulo-peso: 500; --lista-titulo-cor: var(--texto-900); --lista-hover-cor: var(--carmim-700); --lista-hover-fundo: transparent;
    --lista-autoria: var(--tamanho-sm); --lista-autoria-cor: var(--texto-600); --lista-autoria-hover-cor: var(--texto-400);
    --lista-tipo: var(--tamanho-sm); --lista-tipo-cor: var(--texto-600); --lista-tipo-largura: 6.5em; --lista-icone: 1.25em; --lista-icone-traco: 1.6; --lista-icone-cor: var(--neutro-600);
    --lista-seta-cor: var(--neutro-800); }
  .guia-entrada[data-leia-layout="lista"] .cartoes.cartoes-leia { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .guia-entrada[data-leia-layout="lista"] .cartao.leia { grid-template-columns: minmax(0, 1fr) auto var(--lista-tipo-largura) 1.25em; column-gap: var(--lista-gap); row-gap: 2px;
    align-items: center; height: auto; padding: var(--lista-py) 0; border: 0; border-radius: 0; background: transparent;
    transition: background-color 150ms ease; }
  /* divisor só entre os itens: nada antes do primeiro nem depois do último */
  .guia-entrada[data-leia-layout="lista"] .cartoes-leia > li + li > .cartao.leia { border-top: var(--lista-divisor-espessura) solid var(--lista-divisor); }
  .guia-entrada[data-leia-layout="lista"] a.cartao.leia:hover, .guia-entrada[data-leia-layout="lista"] a.cartao.leia[data-forcar-hover] { background: var(--lista-hover-fundo); }
  .guia-entrada[data-leia-layout="lista"] .cartao.leia .leia-titulo { grid-column: 1; grid-row: 1; font: var(--lista-titulo-peso) var(--lista-titulo)/1.3 var(--fonte-dm-sans); color: var(--lista-titulo-cor); transition: color 150ms ease; }
  .guia-entrada[data-leia-layout="lista"] a.cartao.leia:hover .leia-titulo, .guia-entrada[data-leia-layout="lista"] a.cartao.leia[data-forcar-hover] .leia-titulo { color: var(--lista-hover-cor); }
  .guia-entrada[data-leia-layout="lista"] .cartao.leia .leia-autoria { grid-column: 1; grid-row: 2; font-size: var(--lista-autoria); color: var(--lista-autoria-cor); transition: color 150ms ease; }
  /* com o mouse, a autoria clareia (cinza mais claro, não o carmim do resto), para o título aparecer sozinho */
  .guia-entrada[data-leia-layout="lista"] a.cartao.leia:is(:hover, [data-forcar-hover]) .leia-autoria { color: var(--lista-autoria-hover-cor); }
  .guia-entrada[data-leia-layout="lista"] .cartao.leia > :global(svg) { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: var(--lista-icone); height: var(--lista-icone);
    stroke-width: var(--lista-icone-traco); margin: 0; color: var(--lista-icone-cor); }
  /* o nome do tipo alinhado à direita da coluna dele, encostado na seta */
