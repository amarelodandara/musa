---
// Um guia do /guia: o texto vem de src/data/guia/<slug>.md. Tipografia em src/styles/guia-texto.css (playground
// /dev/guia-tipografia). Sem o rótulo "Guia" em cima do título: as migalhas, ao lado, já dizem onde a pessoa está.
import Guia from "../../layouts/Guia.astro";
import { guias } from "../../lib/guia";
import "../../styles/guia-texto.css";
export function getStaticPaths() { return guias.map((g) => ({ params: { guia: g.slug }, props: { g } })); }
const { g } = Astro.props;
const { Content } = g;
---
<Guia titulo={g.titulo} atual={g.slug}>
  <article class="guia-texto">
    <h1>{g.titulo}</h1>
    <p class="lead">{g.resumo}</p>
    <Content />
  </article>
</Guia>
