---
// Playground: o cartão do "Leia mais" (src/pages/guia/index.astro), com e sem link, em cada estado.
// O quadro carrega a própria /guia, esconde tudo menos a seção Leia mais e troca os cartões da grade pelos do estado
// (clones dos cartões da página, então o CSS é o de verdade). Painel em _dials.ts (variáveis e data-leia-* no .guia-entrada).
if (!import.meta.env.DEV) return Astro.redirect("/");
// cada estado: as fontes que entram na grade (tipo, com ou sem link, e o que muda no texto) e o que fica forçado
const L = true, S = false;
const GRUPOS = [
  { titulo: "Grade inteira", estados: [
    { id: "grade", rotulo: "Todas as fontes (1440)", largura: 1440, cartoes: null },
    { id: "grade-notebook", rotulo: "Todas as fontes (1280)", largura: 1280, cartoes: null },
    { id: "grade-celular", rotulo: "Todas as fontes (390)", largura: 390, cartoes: null }
  ]},
  { titulo: "Com link", estados: ["livro", "artigo", "documento", "video", "site"].map((t) => ({ id: `link-${t}`, rotulo: { livro: "Livro", artigo: "Artigo", documento: "Documento", video: "Vídeo", site: "Site" }[t], largura: 1440, cartoes: [{ tipo: t, link: L }] })) },
  { titulo: "Sem link", estados: ["livro", "artigo", "documento", "video", "site"].map((t) => ({ id: `sem-${t}`, rotulo: { livro: "Livro", artigo: "Artigo", documento: "Documento", video: "Vídeo", site: "Site" }[t], largura: 1440, cartoes: [{ tipo: t, link: S }] })) },
  { titulo: "Estados", estados: [
    { id: "lado-a-lado", rotulo: "Com e sem link, lado a lado", largura: 1440, cartoes: [{ tipo: "artigo", link: L }, { tipo: "livro", link: S }] },
    { id: "hover", rotulo: "Mouse em cima (com link)", largura: 1440, cartoes: [{ tipo: "artigo", link: L, hover: true }, { tipo: "livro", link: S, hover: true }] },
    { id: "foco", rotulo: "Foco do teclado (com link)", largura: 1440, cartoes: [{ tipo: "artigo", link: L, foco: true }, { tipo: "livro", link: S }] }
  ]},
  { titulo: "Texto no limite", estados: [
    { id: "titulo-longo", rotulo: "Título longo", largura: 1440, cartoes: [{ tipo: "artigo", link: L, titulo: "Antes, durante e depois: a visita escolar como jornada de serviço e o que isso muda para o educativo de museus pequenos" }, { tipo: "livro", link: S }] },
    { id: "titulo-curto", rotulo: "Título curto", largura: 1440, cartoes: [{ tipo: "livro", link: S, titulo: "Mediar" }, { tipo: "artigo", link: L }] },
    { id: "varias-autorias", rotulo: "Várias autorias", largura: 1440, cartoes: [{ tipo: "artigo", link: L, autoria: "Rafael Quintela, Marina Ost, Helena Barros Fontoura, Teodoro Lins e Lúcia Amaral Peixoto" }, { tipo: "livro", link: S }] },
    { id: "instituicao", rotulo: "Autoria institucional", largura: 1440, cartoes: [{ tipo: "documento", link: L, autoria: "Secretaria Exemplo de Cultura, Coordenação de Acessibilidade e Inclusão" }, { tipo: "documento", link: S, autoria: "Instituto Exemplo de Museus" }] },
    { id: "dominio-longo", rotulo: "Domínio longo", largura: 1440, cartoes: [{ tipo: "site", link: L, href: "https://observatorio-de-publicos.cultura.example.org/escolas" }, { tipo: "video", link: L }] }
  ]},
  { titulo: "Larguras", estados: [
    { id: "tablet", rotulo: "Tablet (900)", largura: 900, cartoes: [{ tipo: "artigo", link: L }, { tipo: "livro", link: S }] },
    { id: "celular", rotulo: "Celular (390)", largura: 390, cartoes: [{ tipo: "artigo", link: L }, { tipo: "livro", link: S }] }
  ]}
]
// o texto de partida de cada tipo (de exemplo, inventado)
const EXEMPLOS = {
  livro: { titulo: "A escola vai ao museu", autoria: "Helena Barros Fontoura", ano: 2019, href: "https://example.org/livro" },
  artigo: { titulo: "O agendamento como primeira mediação", autoria: "Rafael Quintela e Marina Ost", ano: 2022, href: "https://example.org/artigo" },
  documento: { titulo: "Caderno de orientações para ações educativas", autoria: "Instituto Exemplo de Museus", ano: 2018, href: "https://example.org/documento" },
  video: { titulo: "Mediar para quem nunca entrou num museu", autoria: "Coletivo Exemplo", ano: 2021, href: "https://example.org/video" },
  site: { titulo: "Observatório Exemplo de Públicos", autoria: "Rede Exemplo de Museus", ano: 2024, href: "https://example.org/site" }
};
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Guia: cartão do leia mais</title>
<style>
  body { margin: 0; background: #e9e6e5; }
  /* palco: a página do mapa num quadro, na largura de produção, recortada na barra */
  .state-stage { overflow: hidden; border-radius: 8px; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12), 0 8px 24px rgb(0 0 0 / 0.08); background: #fff; justify-self: start; }
  .state-stage iframe { display: block; border: 0; width: 1440px; height: 960px; }

  /* seletor de estados: fora do sistema visual de propósito (spec da skill state-machine) */
  .state-page { container: state-page / inline-size; padding: 24px; min-height: 100dvh; box-sizing: border-box; }
  .state-layout { display: flex; flex-direction: column; gap: 16px; }
  .state-switcher { all: unset; display: none; flex-direction: column; gap: 16px; max-height: calc(100dvh - 48px); overflow-y: auto; scrollbar-width: none; padding: 6px;
    border-radius: 14px; background: rgb(20 20 20 / 0.92); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    font: 13px/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; user-select: none; }
  .state-switcher[hidden], .state-switcher-select[hidden] { display: none !important; }
  .state-switcher-group { display: flex; flex-direction: column; gap: 2px; }
  .state-switcher-heading { display: flex; align-items: center; gap: 6px; padding: 4px 10px 6px; font-size: 11px; font-weight: 500; color: rgb(255 255 255 / 0.45); }
  .state-switcher button { all: unset; flex: none; padding: 8px 10px; border-radius: 8px; font: inherit; color: rgb(255 255 255 / 0.6); cursor: pointer;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color 200ms ease-out; }
  .state-switcher button:hover { color: rgb(255 255 255 / 0.85); }
  .state-switcher button[aria-pressed="true"] { background: rgb(255 255 255 / 0.14); color: rgb(255 255 255); }
  .state-switcher button:focus-visible { outline: 2px solid rgb(255 255 255 / 0.7); outline-offset: 2px; }
  .state-switcher-select { position: relative; align-self: flex-start; max-width: 100%; color: rgb(255 255 255); }
  .state-switcher-select select { all: unset; box-sizing: border-box; max-width: 100%; padding: 10px 36px 10px 16px; border-radius: 999px; background: rgb(20 20 20 / 0.92);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); font: 500 13px/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; cursor: pointer; }
  .state-switcher-select svg { position: absolute; top: 50%; right: 14px; translate: 0 -50%; pointer-events: none; color: rgb(255 255 255 / 0.6); }
  /* 208px lista + 24px + 1440px do palco */
  @container state-page (min-width: 1672px) {
    .state-layout { display: grid; grid-template-columns: 208px auto; gap: 24px; align-items: start; }
    .state-switcher { display: flex; position: sticky; top: 24px; }
    .state-switcher-select { display: none; }
  }
</style>
</head>
<body>
<div class="state-page">
  <div class="state-layout">
    <nav class="state-switcher" aria-label="Estados">
      {GRUPOS.map((g, gi) => (
        <div class="state-switcher-group" role="group" aria-labelledby={`estados-${gi}`}>
          <span class="state-switcher-heading" id={`estados-${gi}`}>
            <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v4a3 3 0 0 0 3 3h7" /><path d="m10 7 3 3-3 3" /></svg>
            {g.titulo}
          </span>
          {g.estados.map((e) => <button type="button" data-state={e.id} aria-pressed="false">{e.rotulo}</button>)}
        </div>
      ))}
    </nav>
    <div class="state-switcher-select">
      <select aria-label="Estado">
        {GRUPOS.map((g) => <optgroup label={g.titulo}>{g.estados.map((e) => <option value={e.id}>{e.rotulo}</option>)}</optgroup>)}
      </select>
      <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4" /></svg>
    </div>
    <div class="state-stage"><iframe title="Guia: cartão do leia mais" src="about:blank"></iframe></div>
  </div>
</div>

<script is:inline define:vars={{ GRUPOS, EXEMPLOS }}>
  const todos = GRUPOS.flatMap((g) => g.estados);
  const quadro = document.querySelector(".state-stage iframe");
  const lista = document.querySelector(".state-switcher"), seletor = document.querySelector(".state-switcher-select");
  const select = seletor.querySelector("select");

  function mostrar(id) {
    const e = todos.find((x) => x.id === id) || todos[0];
    const u = new URL(location.href); u.searchParams.set("__state", e.id); history.replaceState(null, "", u);
    lista.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.state === e.id)));
    select.value = e.id;
    quadro.style.width = e.largura + "px";
    // a grade inteira precisa de altura para caber as doze fontes
    quadro.style.height = (e.cartoes ? 560 : e.largura < 600 ? 2200 : 1100) + "px";
    if (!quadro.src.endsWith("/guia")) quadro.src = "/guia";
    montar();
  }
  // Monta o estado no quadro: esconde o resto da página, troca os cartões da grade por clones montados com o texto do estado
  let moldes = null;
  function montar() {
    const id = new URLSearchParams(location.search).get("__state") || todos[0].id;
    const e = todos.find((x) => x.id === id) || todos[0];
    const d = quadro.contentDocument, grade = d?.querySelector(".cartoes-leia");
    if (!grade) { setTimeout(montar, 100); return; }
    if (!moldes) {
      const icones = {};
      grade.querySelectorAll(".cartao.leia[data-tipo]").forEach((c) => { icones[c.dataset.tipo] ??= c.querySelector(":scope > svg").cloneNode(true); });
      moldes = { link: grade.querySelector("a.cartao.leia").cloneNode(true), sem: grade.querySelector("div.cartao.leia").cloneNode(true), icones,
        // as fontes da página, para o estado "Grade inteira"
        todas: [...grade.children].map((li) => li.cloneNode(true)) };
      // só a seção Leia mais, no topo
      const estilo = d.createElement("style");
      estilo.textContent = ".guia-entrada > :not(section:has(#leia-mais)) { display: none !important; } .guia { padding-top: 24px !important; } footer { display: none !important; }";
      d.head.append(estilo);
    }
    if (!e.cartoes) { grade.replaceChildren(...moldes.todas.map((li) => li.cloneNode(true))); d.defaultView.scrollTo(0, 0); return; }
    grade.replaceChildren(...e.cartoes.map((c) => {
      const x = { ...EXEMPLOS[c.tipo], ...c }, cartao = (c.link ? moldes.link : moldes.sem).cloneNode(true);
      cartao.dataset.tipo = c.tipo;
      cartao.querySelector(":scope > svg").replaceWith(moldes.icones[c.tipo].cloneNode(true));
      cartao.querySelector(".leia-tipo").textContent = moldes.icones[c.tipo].getAttribute("aria-label");
      cartao.querySelector(".leia-titulo").textContent = x.titulo;
      cartao.querySelector(".leia-autoria").firstChild.textContent = x.autoria;
      cartao.querySelector(".leia-ano").textContent = ` · ${x.ano}`;
      if (c.link) { cartao.href = x.href; cartao.querySelector(".leia-link-dominio").textContent = new URL(x.href).hostname; }
      cartao.toggleAttribute("data-forcar-hover", !!c.hover);
      cartao.toggleAttribute("data-forcar-foco", !!c.foco);
      const li = d.createElement("li"); li.append(cartao); return li;
    }));
    d.defaultView.scrollTo(0, 0);
  }
  quadro.addEventListener("load", () => { moldes = null; montar(); });
  lista.addEventListener("click", (ev) => { const b = ev.target.closest("[data-state]"); if (b) mostrar(b.dataset.state); });
  select.addEventListener("change", () => mostrar(select.value));
  addEventListener("keydown", (ev) => {
    if (ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.altKey || ev.shiftKey) return;
    if (ev.target.closest("input, textarea, select, [contenteditable]")) return;
    if (ev.key === "h" || ev.key === "H") { lista.hidden = !lista.hidden; seletor.hidden = !seletor.hidden; return; }
    const d = ev.key === "ArrowDown" || ev.key === "ArrowRight" ? 1 : ev.key === "ArrowUp" || ev.key === "ArrowLeft" ? -1 : 0;
    if (!d) return;
    ev.preventDefault();
    const atual = new URLSearchParams(location.search).get("__state") || todos[0].id;
    const i = todos.findIndex((x) => x.id === atual);
    mostrar(todos[(i + d + todos.length) % todos.length].id);
  });
  mostrar(new URLSearchParams(location.search).get("__state"));
</script>
<!-- painel de ajuste (DialKit) -->
<script>import "./_dials.ts";</script>
</body>
</html>
