---
// Revisão da abertura, só em desenvolvimento. No site publicado redireciona para o início.
import Base from "../../layouts/Base.astro";
import Abertura from "../../components/Abertura.astro";
const dev = import.meta.env.DEV;
if (!dev) return Astro.redirect("/");
---
<Base titulo="Abertura · revisão" cabecalho={false} rodape={false}>
<style is:inline slot="head">
  /* espaço fixo para os painéis à direita, para não cobrirem o palco */
  @media (min-width: 900px) { body { padding-right: 320px; } }
</style>
<p style="position:fixed;left:16px;bottom:16px;z-index:50;margin:0;padding:8px 12px;border-radius:6px;background:#141111;color:#fcf9f9;font:500 13px/1.3 system-ui,sans-serif">Versão anterior (texto por cima no fim). A atual é <a href="/dev/abertura-mapa" style="color:#f7b39c">/dev/abertura-mapa</a>.</p>
<Abertura />
<Fragment slot="scripts">
  <script is:inline>window.MUSA_ABERTURA_SEMPRE = true;</script>
  <script is:inline src="/scripts/abertura.js"></script>
  <script is:inline type="module" src="/dev/abertura-dials.js"></script>
</Fragment>
</Base>
