---
// Página descartável (skill state-machine): o topo de cada Etapa (número, nome, "Ver tudo", setas), com o mapa inteiro à vista.
// Mostra a própria página /mapa num quadro. Cada estado liga pelo que o app já lê: ?modo=, ?fases= (filtro), #etapa (a aberta).
// Painel de ajuste do visual: _dials.ts (DialKit), mexe dentro do quadro. Nada no código do mapa muda.
// Para remover: apagar esta pasta.
if (!import.meta.env.DEV) return Astro.redirect("/");
const GRUPOS = [
  { titulo: "Visão detalhada", estados: [
    { id: "detalhada-antes", rotulo: "Etapa aberta em Antes", busca: "modo=etapa&marca=olho", hash: "descoberta" },
    { id: "detalhada-durante", rotulo: "Etapa aberta em Durante", busca: "modo=etapa&marca=olho", hash: "mediacao" },
    { id: "detalhada-depois", rotulo: "Etapa aberta em Depois", busca: "modo=etapa&marca=olho", hash: "vinculo" }
  ]},
  { titulo: "Visão geral", estados: [
    { id: "geral", rotulo: "Todas as fases", busca: "modo=inteiro&marca=olho" }
  ]},
  { titulo: "Celular", estados: [
    { id: "celular", rotulo: "Celular", busca: "modo=etapa&marca=olho", hash: "mediacao", largura: 390 }
  ]},
  { titulo: "Filtro", estados: [
    { id: "filtro-uma", rotulo: "Só Durante", busca: "modo=inteiro&marca=olho&fases=durante-a-visita" },
    { id: "filtro-duas", rotulo: "Antes e Depois", busca: "modo=inteiro&marca=olho&fases=antes-da-visita,depois-da-visita" },
    { id: "filtro-detalhada", rotulo: "Só Depois, visão detalhada", busca: "modo=etapa&marca=olho&fases=depois-da-visita" }
  ]}
];
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Estados · topo das etapas</title>
<style>
  body { margin: 0; background: #e9e6e5; }
  /* palco: a página do mapa num quadro, na largura de produção, recortada na barra */
  .state-stage { overflow: hidden; border-radius: 8px; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12), 0 8px 24px rgb(0 0 0 / 0.08); background: #fff; justify-self: start; }
  .state-stage iframe { display: block; border: 0; width: 1200px; height: 560px; }

  /* seletor de estados: fora do sistema visual de propósito (spec da skill state-machine) */
  .state-page { container: state-page / inline-size; padding: 24px; min-height: 100dvh; box-sizing: border-box; }
  .state-layout { display: flex; flex-direction: column; gap: 16px; }
  .state-switcher { all: unset; display: none; flex-direction: column; gap: 16px; max-height: calc(100dvh - 48px); overflow-y: auto; scrollbar-width: none; padding: 6px;
    border-radius: 14px; background: rgb(20 20 20 / 0.92); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    font: 13px/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; user-select: none; }
  .state-switcher[hidden], .state-switcher-select[hidden] { display: none !important; }
  .state-switcher-group { display: flex; flex-direction: column; gap: 2px; }
  .state-switcher-heading { display: flex; align-items: center; gap: 6px; padding: 4px 10px 6px; font-size: 11px; font-weight: 500; color: rgb(255 255 255 / 0.45); }
  .state-switcher button { all: unset; flex: none; padding: 8px 10px; border-radius: 8px; font: inherit; color: rgb(255 255 255 / 0.6); cursor: pointer;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color 200ms ease-out; }
  .state-switcher button:hover { color: rgb(255 255 255 / 0.85); }
  .state-switcher button[aria-pressed="true"] { background: rgb(255 255 255 / 0.14); color: rgb(255 255 255); }
  .state-switcher button:focus-visible { outline: 2px solid rgb(255 255 255 / 0.7); outline-offset: 2px; }
  .state-switcher-select { position: relative; align-self: flex-start; max-width: 100%; color: rgb(255 255 255); }
  .state-switcher-select select { all: unset; box-sizing: border-box; max-width: 100%; padding: 10px 36px 10px 16px; border-radius: 999px; background: rgb(20 20 20 / 0.92);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); font: 500 13px/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; cursor: pointer; }
  .state-switcher-select svg { position: absolute; top: 50%; right: 14px; translate: 0 -50%; pointer-events: none; color: rgb(255 255 255 / 0.6); }
  /* 208px lista + 24px + 1200px da barra */
  @container state-page (min-width: 1432px) {
    .state-layout { display: grid; grid-template-columns: 208px auto; gap: 24px; align-items: start; }
    .state-switcher { display: flex; position: sticky; top: 24px; }
    .state-switcher-select { display: none; }
  }
</style>
</head>
<body>
<div class="state-page">
  <div class="state-layout">
    <nav class="state-switcher" aria-label="Estados">
      {GRUPOS.map((g, gi) => (
        <div class="state-switcher-group" role="group" aria-labelledby={`estados-${gi}`}>
          <span class="state-switcher-heading" id={`estados-${gi}`}>
            <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v4a3 3 0 0 0 3 3h7" /><path d="m10 7 3 3-3 3" /></svg>
            {g.titulo}
          </span>
          {g.estados.map((e) => <button type="button" data-state={e.id} aria-pressed="false">{e.rotulo}</button>)}
        </div>
      ))}
    </nav>
    <div class="state-switcher-select">
      <select aria-label="Estado">
        {GRUPOS.map((g) => <optgroup label={g.titulo}>{g.estados.map((e) => <option value={e.id}>{e.rotulo}</option>)}</optgroup>)}
      </select>
      <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4" /></svg>
    </div>
    <div class="state-stage"><iframe title="Topo das etapas" src="about:blank"></iframe></div>
  </div>
</div>

<script is:inline define:vars={{ GRUPOS }}>
  const todos = GRUPOS.flatMap((g) => g.estados);
  const quadro = document.querySelector(".state-stage iframe");
  const lista = document.querySelector(".state-switcher"), seletor = document.querySelector(".state-switcher-select");
  const select = seletor.querySelector("select");

  function mostrar(id) {
    const e = todos.find((x) => x.id === id) || todos[0];
    const u = new URL(location.href); u.searchParams.set("__state", e.id); history.replaceState(null, "", u);
    lista.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.state === e.id)));
    lista.querySelector("[aria-pressed='true']")?.scrollIntoView({ block: "nearest" });
    select.value = e.id;
    // memória do navegador que o mapa lê: primeira visita abre a introdução
    try { e.primeiraVisita ? localStorage.removeItem("musa:guia-visto") : localStorage.setItem("musa:guia-visto", "sim"); } catch {}
    quadro.style.width = (e.largura || 1200) + "px";
    quadro.style.height = (e.altura || 560) + "px";
    quadro.onload = () => {
      if (!e.abrirFiltro) return;
      // abre o menu como a pessoa faria (clique no botão), depois de a ilha hidratar
      const tentar = (n) => {
        const b = quadro.contentDocument?.querySelector('[aria-label^="Filtrar visualização"]');
        if (b && b.isConnected && quadro.contentWindow.musaMapa) { b.click(); return; }
        if (n > 0) setTimeout(() => tentar(n - 1), 150);
      };
      setTimeout(() => tentar(40), 300);
    };
    quadro.src = "/mapa?" + e.busca + (e.hash ? "#" + e.hash : "");
  }

  lista.addEventListener("click", (ev) => { const b = ev.target.closest("[data-state]"); if (b) mostrar(b.dataset.state); });
  select.addEventListener("change", () => mostrar(select.value));
  addEventListener("keydown", (ev) => {
    if (ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.altKey || ev.shiftKey) return;
    if (ev.target.closest("input, textarea, select, [contenteditable]")) return;
    if (ev.key === "h" || ev.key === "H") { lista.hidden = !lista.hidden; seletor.hidden = !seletor.hidden; return; }
    const d = ev.key === "ArrowDown" || ev.key === "ArrowRight" ? 1 : ev.key === "ArrowUp" || ev.key === "ArrowLeft" ? -1 : 0;
    if (!d) return;
    ev.preventDefault();
    const atual = new URLSearchParams(location.search).get("__state") || todos[0].id;
    const i = todos.findIndex((x) => x.id === atual);
    mostrar(todos[(i + d + todos.length) % todos.length].id);
  });
  mostrar(new URLSearchParams(location.search).get("__state"));
</script>
<!-- painel de ajuste do visual da barra (DialKit) -->
<script>import "./_dials.ts";</script>
</body>
</html>
