---
// Bancada: as peças do mapa que aparecem no cartão dos links do Guia (src/components/guia/PreviaMapa.astro), todas
// juntas, do jeito que o cartão mostra (desenho 3:2 e legenda), e ao lado em 2x para ver os detalhes.
import Base from "../../../layouts/Base.astro";
import PreviaMapa from "../../../components/guia/PreviaMapa.astro";
import { TERMOS_COM_PREVIA, legendaPrevia } from "../../../lib/previas-mapa";
if (!import.meta.env.DEV) return Astro.redirect("/");
---
<Base titulo="Peças do mapa no Guia" rodape={false}>
<main class="bancada">
  <p class="nota">Cartões dos links do Guia: à esquerda, no tamanho de verdade; à direita, em 2x.</p>
  {TERMOS_COM_PREVIA.map((t) => (
    <section class="linha">
      <p class="termo">{t}</p>
      <div class="cartao"><PreviaMapa termo={t} /><span class="legenda">{legendaPrevia(t)}</span></div>
      <div class="zoom"><PreviaMapa termo={t} /></div>
    </section>
  ))}
</main>
</Base>

<style>
  .bancada { max-width: 1100px; margin: 0 auto; padding: 32px 24px 96px; display: grid; gap: 40px; }
  .nota, .termo { margin: 0; font: 500 12px/1.3 system-ui, sans-serif; color: var(--texto-600); }
  .linha { display: grid; grid-template-columns: 160px 318px 1fr; gap: 32px; align-items: start; }
  /* o mesmo cartão do Guia (src/layouts/Guia.astro, .previa-mapa) */
  .cartao { width: 318px; padding: 8px 8px 10px; background: var(--neutro-50); border: 1px solid var(--neutro-300); border-radius: 10px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 16px 40px -16px rgb(0 0 0 / 0.22); }
  .legenda { display: block; margin-top: 8px; font-size: var(--tamanho-xs); line-height: 1.4; color: var(--texto-700); text-wrap: pretty; }
  .zoom { zoom: 2; }
</style>
